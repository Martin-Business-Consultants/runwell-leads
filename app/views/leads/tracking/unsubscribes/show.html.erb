<% @page_title = "Unsubscribe" %>
<section class="panel shadow flex flex-column gap-half txt-align-center">
  <% if @lead.unsubscribed? %>
    <h1 class="txt-medium font-weight-black margin-none">You’re unsubscribed</h1>
    <p class="txt-small margin-none"><%= @lead.email %> won’t get these emails any more.</p>
  <% else %>
    <h1 class="txt-medium font-weight-black margin-none">Unsubscribe?</h1>
    <p class="txt-small margin-none">Stop the emails we send to <strong><%= @lead.email %></strong>.</p>
    <%= button_to "Unsubscribe", leads_mail_unsubscribe_path(token: params[:token]), class: "btn btn--link center" %>
  <% end %>
</section>
