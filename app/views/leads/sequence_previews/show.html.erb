<% @page_title = "Preview: " + @sequence.name %>
<%= parent_page @sequence.name, edit_leads_sequence_path(@sequence) %>

<% content_for :page_actions do %>
  <%= link_to "Edit sequence", edit_leads_sequence_path(@sequence), class: ui(:button) %>
<% end %>
<%= render "layouts/shared/page_header", title: @sequence.name,
      description: "Its emails as #{@lead.persisted? ? @lead.display_name : "a sample lead (" + @lead.name + ")"} would get them, in order. Links aren’t tracked here." %>

<div class="flex max-w-3xl flex-col gap-6">
  <% @sequence.steps.each do |step| %>
    <%# herb:key step.id %>
    <% email = Leads::SequenceMailer.with(step: step, lead: @lead).test_email %>
    <section class="<%= ui(:panel, "overflow-hidden") %>">
      <header class="flex flex-col gap-1 border-b border-gray-200 px-5 py-3.5">
        <span class="text-xs text-gray-500">Email <%= step.number %> · <%= step.delay_label %> <%= step.position.to_i.zero? ? "after enrolling" : "after the one before" %></span>
        <h2 class="<%= ui(:heading) %>"><%= email.subject.delete_prefix("[Test] ") %></h2>
        <span class="truncate text-xs text-gray-500">From <%= email[:from].to_s %> · to <%= @lead.email %></span>
      </header>
      <%= tag.iframe class: "block h-96 w-full bg-white", title: "Email #{step.number}", sandbox: "", srcdoc: email.html_part.body.decoded %>
    </section>
  <% end %>
  <% if @sequence.steps.none? %>
    <p class="py-12 text-center text-sm text-gray-500">No emails yet. <%= link_to "Write the first", edit_leads_sequence_path(@sequence), class: ui(:link) %></p>
  <% end %>
</div>
