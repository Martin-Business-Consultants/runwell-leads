<% content_for :preheader, @due.first(3).map { "#{it.title} (#{it.lead.display_name})" }.join(", ").presence || "Your leads this morning." %>
<% content_for :reason, "You’re getting this because you have open leads. The time it comes, or whether it does, is in Settings › Plugins › Leads." %>
<%= mail_heading "Your leads this morning" %>
<% if @due.any? %>
  <p><strong>To do today</strong></p>
  <ul>
    <% @due.each do |step| %>
      <%# herb:key step.id %>
      <li><a href="<%= lead_url(step.lead) %>"><%= step.lead.display_name %></a>: <%= step.title %><% if step.overdue? %> <strong>(was due <%= step.due_on.strftime("%b %-d") %>)</strong><% end %></li>
    <% end %>
  </ul>
<% end %>
<% if @cold.any? %>
  <p><strong>Going cold</strong>: nobody’s been in touch for a while.</p>
  <ul>
    <% @cold.each do |lead| %>
      <%# herb:key lead.id %>
      <li><a href="<%= lead_url(lead) %>"><%= lead.display_name %></a>, last touched <%= time_ago_in_words(lead.last_touch_at) %> ago<% if lead.stage %>, at <%= lead.stage.name %><% end %></li>
    <% end %>
  </ul>
<% end %>
<% if @nobody.any? %>
  <p><strong>Nobody has these yet</strong></p>
  <ul>
    <% @nobody.each do |lead| %>
      <%# herb:key lead.id %>
      <li><a href="<%= lead_url(lead) %>"><%= lead.display_name %></a><% if lead.source %>, from <%= lead.source %><% end %>, came in <%= time_ago_in_words(lead.created_at) %> ago</li>
    <% end %>
  </ul>
<% end %>
<% if @due.empty? && @cold.empty? && @nobody.empty? %>
  <p>Nothing is due on your leads today.</p>
<% end %>
<%= mail_button "Open your leads", @url %>
