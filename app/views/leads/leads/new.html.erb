<% @page_title = "Add a lead" %>
<%= leads_section_nav :leads %>

<% content_for :header do %>
  <%= parent_page "Leads", leads_path %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "leads/leads/form", lead: @lead %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section">
      <header>
        <h2 class="divider">What comes next</h2>
      </header>
      <ol class="record-steps txt-small">
        <li>Add a follow-up: what to do about them, and by when. It shows on that person’s home page when it’s due.</li>
        <li>Start an email sequence, or move their stage as you talk: a stage can start sequences of its own.</li>
        <li>When they say yes, make them a <%= term(:client).downcase %>.</li>
      </ol>
    </section>
  </aside>
</section>
