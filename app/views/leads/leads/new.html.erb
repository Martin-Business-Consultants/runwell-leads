<% @page_title = "Add lead" %>
<%= parent_page "Leads", leads_path %>

<%= render "layouts/shared/page_header", title: @page_title, description: "Someone who got in touch another way: a call, a card, a conversation. Form submissions add themselves." %>
<%= render "layouts/shared/errors", record: @lead %>

<%= form_with model: @lead, url: leads_path, scope: :lead, class: "flex flex-col gap-6 lg:flex-row lg:items-start" do |form| %>
  <section class="<%= ui(:panel, "min-w-0 flex-1") %>">
    <h2 class="<%= ui(:heading, "border-b border-gray-200 px-5 py-3.5") %>">Details</h2>
    <div class="grid grid-cols-1 gap-5 p-5 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Email</span>
        <%= form.email_field :email, class: "w-full", required: true, autofocus: true, autocomplete: "off" %>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Name</span>
        <%= form.text_field :name, class: "w-full", autocomplete: "off" %>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Phone</span>
        <%= form.telephone_field :phone, class: "w-full", autocomplete: "off" %>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Company</span>
        <%= form.text_field :company, class: "w-full", autocomplete: "off" %>
      </label>
    </div>
  </section>

  <aside class="flex shrink-0 flex-col gap-4 lg:w-80">
    <% extra = capture do %>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Stage</span>
        <%= form.select :stage, lead_stage_options, {}, class: "w-full" %>
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="<%= ui(:label) %>">Owner</span>
        <%= form.select :owner_id, lead_user_options, { include_blank: "No owner" }, class: "w-full" %>
      </label>
    <% end %>
    <%= render "layouts/shared/save_box", key: "lead-save", title: "Lead", button: "Add lead", extra: extra %>
  </aside>
<% end %>
<%= render "content_form/postbox_state" %>
