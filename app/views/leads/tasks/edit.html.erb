<% @page_title = "Edit follow-up" %>
<%= leads_section_nav :tasks %>

<% content_for :header do %>
  <%= parent_page @task.lead.display_name, lead_path(@task.lead) %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "layouts/shared/errors", record: @task %>
    <%= form_with model: @task, url: leads_task_path(@task), scope: :task, class: "record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
      <label class="record-form__field">
        <span class="record-form__label">What to do</span>
        <%= form.text_field :title, required: true, class: "input full-width", autofocus: true, autocomplete: "off" %>
      </label>
      <div class="record-form__row">
        <label class="record-form__field">
          <span class="record-form__label">Who</span>
          <%= form.select :assignee_id, lead_people_options, { include_blank: "Unassigned" }, class: "input input--select full-width" %>
        </label>
        <label class="record-form__field">
          <span class="record-form__label">Due</span>
          <%= date_input form, :due_on, class: "input full-width" %>
        </label>
      </div>
      <div class="record-form__footer">
        <%= link_to "Cancel", lead_path(@task.lead), class: "btn btn--plain record-form__cancel", data: { form_target: "cancel" } %>
        <button type="submit" class="btn btn--link" data-form-target="submit"><span>Save changes</span></button>
      </div>
    <% end %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Details</h2>
      </header>
      <dl class="record-facts">
        <dt>Lead</dt><dd><%= link_to @task.lead.display_name, lead_path(@task.lead), class: "txt-link" %></dd>
        <dt>Added</dt><dd><%= l @task.created_at.to_date, format: :long %><%= " by " + @task.creator.display_name if @task.creator %></dd>
        <dt>Status</dt><dd><%= status_tag @task.done? ? "Done" : "Open" %></dd>
      </dl>
    </section>
    <%= render "layouts/shared/confirm", trigger: "Delete this follow-up", title: "Delete “#{@task.title_was}”?",
          body: "It goes from the lead. What it said on the timeline stays.", button: "Delete", path: leads_task_path(@task) %>
  </aside>
</section>
