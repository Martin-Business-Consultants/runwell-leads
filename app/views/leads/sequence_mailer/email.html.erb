<% content_for :reason, "You’re getting this because you got in touch with us." %>
<%= @body_html %>
<% if @unsubscribe_url %>
  <%= mail_small do %>
    Rather not hear from us? <%= link_to "Unsubscribe", @unsubscribe_url, style: "color:#8a8c93;" %>.
  <% end %>
  <img src="<%= @open_url %>" width="1" height="1" alt="" style="display:block;border:0;width:1px;height:1px;">
<% end %>
