<%# locals: (template:) %>
<%= render "layouts/shared/errors", record: template %>

<%= form_with model: template, url: template.new_record? ? leads_templates_path : leads_template_path(template), scope: :template, class: "record-form",
      data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <div class="record-form__row record-form__row--narrow-first">
    <label class="record-form__field">
      <span class="record-form__label">Kind</span>
      <%= form.select :kind, Leads::Template::KINDS.invert, {}, class: "input input--select full-width" %>
    </label>
    <label class="record-form__field">
      <span class="record-form__label">Name</span>
      <%= form.text_field :title, required: true, class: "input full-width", autofocus: template.new_record?, autocomplete: "off", placeholder: "First reply to a website enquiry" %>
    </label>
  </div>
  <label class="record-form__field">
    <span class="record-form__label">When to use it</span>
    <%= form.text_field :situation, class: "input full-width", autocomplete: "off", placeholder: "Within minutes of a new lead coming in" %>
  </label>
  <label class="record-form__field">
    <span class="record-form__label">Subject</span>
    <%= form.text_field :subject, class: "input full-width", autocomplete: "off", placeholder: "Re: your enquiry, {{first_name}}" %>
    <span class="record-form__hint">Emails only.</span>
  </label>
  <div class="record-form__field">
    <span class="record-form__label">What to send or say</span>
    <%= rich_text_field form, :body, placeholder: "Hi {{first_name}}, …" %>
    <span class="record-form__hint">{{first_name}}, {{name}}, {{company}}, {{email}}, {{phone}}, {{my_name}} and {{business}} are filled in for each lead.</span>
  </div>
  <div class="record-form__footer">
    <%= link_to "Cancel", leads_templates_path, class: "btn btn--plain record-form__cancel", data: { form_target: "cancel" } %>
    <button type="submit" class="btn btn--link" data-form-target="submit"><span><%= template.new_record? ? "Add template" : "Save changes" %></span></button>
  </div>
<% end %>
