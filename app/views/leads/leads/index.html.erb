<% @page_title = "Leads" %>
<%= leads_section_nav :leads %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :stage, current: @stage, options: Leads::Lead.filter_options %>
  <%= render "layouts/shared/quick_filter", title: "Whose…", param: :owner, current: @owner.to_s, options: lead_owner_filter_options %>
  <form action="<%= leads_path %>" method="get" class="leads-search">
    <input type="hidden" name="stage" value="<%= @stage %>">
    <input type="search" name="q" value="<%= params[:q] %>" class="input txt-x-small" placeholder="Name, email or company" aria-label="Search leads" autocomplete="off">
  </form>
<% end %>
<%= render "layouts/shared/index_toolbar", new_text: "Add a lead", new_path: new_lead_path %>

<% if @leads.any? %>
  <section class="panel shadow center index-table">
    <table class="data-table">
      <thead>
        <tr><th>Lead</th><th>Stage</th><th class="data-table__number">Score</th><th>Owner</th><th>Last active</th><th></th></tr>
      </thead>
      <tbody>
        <% @leads.each do |lead| %>
          <%# herb:key lead.id %>
          <tr data-filter-target="item">
            <td>
              <%= link_to lead_path(lead), class: "txt-ink" do %>
                <strong><%= lead.display_name %></strong>
                <div class="txt-x-small txt-subtle overflow-ellipsis"><%= [ (lead.email if lead.name.present?), lead.company ].compact_blank.join(" · ") %></div>
              <% end %>
            </td>
            <td><%= lead_stage_tag lead.stage %></td>
            <td class="data-table__number"><%= lead.score %></td>
            <td><%= person_tag lead.owner, fallback: "Unassigned" %></td>
            <td class="txt-subtle txt-nowrap"><%= time_ago_in_words(lead.last_activity_at || lead.created_at) %> ago</td>
            <%= render "layouts/shared/row_actions", name: lead.display_name, edit_path: edit_lead_path(lead), delete_path: lead_path(lead),
                  delete_message: "This forgets the lead with its timeline, tasks and the emails sent to it." %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <% if @page > 1 || @more %>
    <nav class="flex gap-half justify-center margin-block txt-small" aria-label="Pages">
      <% if @page > 1 %>
        <%= link_to "Newer", url_for(request.query_parameters.merge("page" => @page - 1)), class: "btn txt-small" %>
      <% end %>
      <% if @more %>
        <%= link_to "Older", url_for(request.query_parameters.merge("page" => @page + 1)), class: "btn txt-small" %>
      <% end %>
    </nav>
  <% end %>
<% elsif Leads::Lead.exists? %>
  <div class="blank-slate">
    No leads match.
    <%= link_to "Show all", leads_path(stage: "all"), class: "txt-link" %>
  </div>
<% else %>
  <div class="panel panel--centered flex flex-column gap-half">
    <p class="txt-medium">No leads yet.</p>
    <p class="txt-small txt-subtle margin-none">They come in from your website’s forms (Settings › Leads shows how), or add one yourself.</p>
    <%= link_to new_lead_path, class: "btn btn--link center" do %>
      <span>Add your first lead</span>
      <%= icon_tag "arrow-right" %>
    <% end %>
  </div>
<% end %>
