<% @page_title = "Unsubscribe" %>
<section class="<%= ui(:panel, "mx-auto flex max-w-md flex-col gap-4 p-6 text-center") %>">
  <% if @lead.unsubscribed? %>
    <h1 class="text-xl font-semibold text-gray-900">You’re unsubscribed</h1>
    <p class="text-sm text-gray-600"><%= @lead.email %> won’t get these emails any more.</p>
  <% else %>
    <h1 class="text-xl font-semibold text-gray-900">Unsubscribe?</h1>
    <p class="text-sm text-gray-600">Stop the emails we send to <strong class="font-medium text-gray-900"><%= @lead.email %></strong>.</p>
    <%= button_to "Unsubscribe", leads_mail_unsubscribe_path(token: params[:token]), class: ui(:button, :primary, "w-full"), form_class: "w-full" %>
  <% end %>
</section>
