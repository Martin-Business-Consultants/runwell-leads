<%# locals: (sequence:) %>
<%= render "layouts/shared/errors", record: sequence %>

<%= form_with model: sequence, url: sequence.new_record? ? leads_sequences_path : leads_sequence_path(sequence), scope: :sequence, id: dom_id(sequence, :form),
      class: "record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <label class="record-form__field">
    <span class="record-form__label">Name</span>
    <%= form.text_field :name, required: true, class: "input full-width", autofocus: sequence.new_record?, autocomplete: "off", placeholder: "New website leads" %>
  </label>

  <label class="record-form__field">
    <span class="record-form__label">Who it starts for</span>
    <%= form.select :trigger, Leads::Sequence::TRIGGERS.invert, {}, class: "input input--select full-width" %>
  </label>

  <div class="record-form__row">
    <label class="record-form__field">
      <span class="record-form__label">From the website: only this form</span>
      <%= form.text_field :trigger_source, class: "input full-width", autocomplete: "off", placeholder: "Any form" %>
      <span class="record-form__hint">The <code>source</code> a form sends, e.g. “Contact page”. Blank for every form.</span>
    </label>
    <label class="record-form__field">
      <span class="record-form__label">Reaches a stage: which</span>
      <%= form.select :trigger_stage, lead_stage_options, { include_blank: "Choose a stage" }, class: "input input--select full-width" %>
    </label>
  </div>

  <div class="record-form__toggle">
    <div class="record-form__toggle-text">
      <%= form.label :active, "On", class: "record-form__label" %>
      <span class="record-form__hint">Emails go only while it’s on. Leads can join while it’s off; theirs wait.</span>
    </div>
    <label class="switch flex-item-no-shrink">
      <%= form.check_box :active, class: "switch__input" %>
      <span class="switch__btn"></span>
    </label>
  </div>

  <div class="record-form__footer">
    <%= link_to "Cancel", sequence.new_record? ? leads_sequences_path : leads_sequence_path(sequence), class: "btn btn--plain record-form__cancel", data: { form_target: "cancel" } %>
    <button type="submit" class="btn btn--link" data-form-target="submit">
      <span><%= sequence.new_record? ? "Add sequence" : "Save changes" %></span>
    </button>
  </div>
<% end %>
