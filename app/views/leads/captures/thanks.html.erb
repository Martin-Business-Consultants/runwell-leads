<% @page_title = "Thank you" %>
<section class="panel shadow flex flex-column gap-half txt-align-center">
  <h1 class="txt-medium font-weight-black margin-none">Thank you</h1>
  <p class="txt-small margin-none">We have your details and we’ll be in touch.</p>
  <% if request.referer.to_s.match?(%r{\Ahttps?://}i) %>
    <%= link_to "Back to where you were", request.referer, class: "btn center" %>
  <% end %>
</section>
