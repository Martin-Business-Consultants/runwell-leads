<% @page_title = "Follow-ups" %>
<%= leads_section_nav :tasks %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :show, current: @show,
        options: [ [ "Mine", "mine" ], [ "Everyone’s", "everyone" ], [ "Done", "done" ] ] %>
<% end %>
<%= render "layouts/shared/index_toolbar" %>

<section class="panel shadow center index-table">
    <table class="data-table">
      <thead>
        <tr><th></th><th>Follow-up</th><th>Lead</th><th><%= @show == "done" ? "Done" : "Due" %></th><th>Who</th><th></th></tr>
      </thead>
      <tbody>
        <% @tasks.each do |task| %>
          <%# herb:key task.id %>
          <tr data-filter-target="item">
            <td>
              <% if task.done? %>
                <%= button_to leads_task_completion_path(task), method: :delete, class: "btn btn--circle borderless", title: "Reopen" do %>
                  <%= icon_tag "check-circle" %><span class="for-screen-reader">Reopen <%= task.title %></span>
                <% end %>
              <% else %>
                <%= button_to leads_task_completion_path(task), class: "btn btn--circle borderless", title: "Mark done" do %>
                  <%= icon_tag "check" %><span class="for-screen-reader">Mark <%= task.title %> done</span>
                <% end %>
              <% end %>
            </td>
            <td><%= link_to task.title, edit_leads_task_path(task), class: "txt-ink font-weight-bold" %></td>
            <td><%= link_to task.lead.display_name, lead_path(task.lead), class: "txt-ink" %></td>
            <td class="<%= class_names("txt-nowrap", "txt-negative": task.overdue?, "txt-subtle": !task.overdue?) %>"><%= lead_task_due(task) %></td>
            <td><%= person_tag task.assignee, fallback: "Unassigned" %></td>
            <%= render "layouts/shared/row_actions", name: task.title, edit_path: edit_leads_task_path(task), delete_path: leads_task_path(task) %>
          </tr>
        <% end %>
        <% if @tasks.empty? %>
          <tr>
            <td colspan="6" class="txt-subtle txt-small">
              <% if @show == "done" %>
                Nothing done yet.
              <% else %>
                Nothing to follow up<%= " for you" if @show == "mine" %>. Follow-ups are added on a lead’s page.
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
