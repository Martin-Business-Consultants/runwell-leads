<% @page_title = "Email sequences" %>
<%= leads_section_nav :sequences %>

<%= render "layouts/shared/index_toolbar", new_text: "Add a sequence", new_path: (new_leads_sequence_path if can?(:manage_sequences)) %>

<% if @sequences.any? %>
  <section class="panel shadow center index-table">
    <table class="data-table">
      <thead>
        <tr><th>Sequence</th><th>Starts</th><th class="data-table__number">Emails</th><th class="data-table__number">In it now</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
        <% @sequences.each do |sequence| %>
          <%# herb:key sequence.id %>
          <tr data-filter-target="item">
            <td><%= link_to sequence.name, leads_sequence_path(sequence), class: "txt-ink font-weight-bold" %></td>
            <td class="txt-subtle"><%= sequence.trigger_label %></td>
            <td class="data-table__number"><%= sequence.steps.size %></td>
            <td class="data-table__number"><%= @counts.fetch(sequence.id, 0) %></td>
            <td><%= status_tag sequence.active? ? "Active" : "Dormant" %></td>
            <% if can?(:manage_sequences) %>
              <%= render "layouts/shared/row_actions", name: sequence.name, edit_path: edit_leads_sequence_path(sequence), delete_path: leads_sequence_path(sequence),
                    delete_message: "Leads in it stop getting its emails. What was sent stays on their timelines." %>
            <% else %>
              <td></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <div class="panel panel--centered flex flex-column gap-half">
    <p class="txt-medium">No email sequences yet.</p>
    <p class="txt-small txt-subtle margin-none">A sequence is a few emails sent one after another, a delay apart: to every lead from your website, everyone who reaches a stage, or those you start it for.</p>
    <% if can?(:manage_sequences) %>
      <%= link_to new_leads_sequence_path, class: "btn btn--link center" do %>
        <span>Write your first sequence</span>
        <%= icon_tag "arrow-right" %>
      <% end %>
    <% end %>
  </div>
<% end %>
