<%# locals: (lead:, activities:, can_write:) %>
<%# Everything that happened to the lead, newest first, with a note box on top. %>
<section id="timeline" class="<%= ui(:panel) %>" aria-labelledby="lead_timeline">
  <header class="flex items-center justify-between gap-4 border-b border-gray-200 px-5 py-3.5">
    <h2 id="lead_timeline" class="<%= ui(:heading) %>">Timeline</h2>
    <span class="text-xs text-gray-500"><%= pluralize(lead.activities.size, "event") %></span>
  </header>
  <% if can_write %>
    <%= form_with url: lead_notes_path(lead), scope: :note, class: "flex flex-col gap-2 border-b border-gray-200 p-5" do |form| %>
      <label class="sr-only" for="note_body">Add a note</label>
      <%= form.text_area :body, rows: 2, class: "w-full", placeholder: "Add a note: a call, a meeting, what they asked for…", required: true %>
      <div class="flex justify-end">
        <button type="submit" class="<%= ui(:button, :small) %>">Add note</button>
      </div>
    <% end %>
  <% end %>
  <% if activities.any? %>
    <ol class="divide-y divide-gray-100">
      <% activities.each do |activity| %>
        <%# herb:key activity.id %>
        <li id="<%= dom_id(activity) %>" class="flex gap-3 px-5 py-3">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-gray-100"><%= lead_activity_icon activity.kind %></span>
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
              <% if activity.note? %>
                <span class="font-medium text-gray-900">Note</span>
              <% else %>
                <span class="text-gray-900"><%= activity.summary %></span>
              <% end %>
              <%= lead_points activity.points %>
            </div>
            <% if activity.note? %>
              <p class="whitespace-pre-line break-words text-sm text-gray-700"><%= activity.body %></p>
            <% end %>
            <span class="text-xs text-gray-500">
              <%= time_ago_tag activity.created_at %><%= " · " + activity.user.name if activity.user %>
            </span>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="py-12 text-center text-sm text-gray-500">Nothing has happened yet.</p>
  <% end %>
</section>
