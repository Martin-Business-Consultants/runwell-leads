<% @page_title = "Edit #{@sequence.name_was}" %>
<%= leads_section_nav :sequences %>

<% content_for :header do %>
  <%= parent_page @sequence.name_was, leads_sequence_path(@sequence) %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "leads/sequences/form", sequence: @sequence %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <%= render "layouts/shared/confirm", trigger: "Delete this sequence", title: "Delete #{@sequence.name_was}?",
          body: "Leads in it stop getting its emails. What was sent stays on their timelines.", button: "Delete sequence", path: leads_sequence_path(@sequence) %>
  </aside>
</section>
