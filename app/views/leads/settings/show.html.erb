<%= render "settings/header", current: :leads %>
<%# The leads' settings (Leads::SettingsController): who's told when a lead comes in, the morning
    email and when a lead goes cold, the stages an open lead moves through and each one's plan, the
    email templates, and the forms that send leads in, each with its own address. %>
<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Who’s told</h2>
      <p class="settings-section__description">Who gets an email when a lead comes in, or a lost one comes back. With nobody picked, every owner and manager does. Whoever a lead is given to is always told.</p>
    </header>
    <%= form_with model: @setting, url: leads_settings_path, method: :patch, scope: :setting, data: { controller: "form" } do |form| %>
      <%= hidden_field_tag "setting[notify_user_ids][]", "", id: nil %>
      <%= form.select :notify_user_ids, leads_people.map { [ it.display_name, it.id ] }, { selected: @setting.notify_user_ids }, multiple: true, aria: { label: "Who’s told" }, data: { action: "change->form#submit" } %>
    <% end %>
  </section>

  <section class="settings-section" id="reminders">
    <header class="settings-section__head">
      <h2>Reminders</h2>
      <p class="settings-section__description">Each morning, everyone with open leads is emailed what’s due today or late and which of theirs are going cold; whoever’s told about new leads also hears which nobody has. Nobody with nothing to do gets an email. A lead goes cold when nobody’s logged a call, email, meeting or note, or done a step, for the days below.</p>
    </header>
    <div class="leads-form__row">
      <%= form_with model: @setting, url: leads_settings_path, method: :patch, scope: :setting, namespace: "digest", data: { controller: "form" } do |form| %>
        <label class="field">
          <span class="field__label">Morning email at</span>
          <%= form.select :digest_hour, lead_digest_hour_options, { selected: @setting.digest_hour.to_s }, data: { action: "change->form#submit" } %>
        </label>
      <% end %>
      <%= form_with model: @setting, url: leads_settings_path, method: :patch, scope: :setting, namespace: "cold", data: { controller: "form" } do |form| %>
        <label class="field">
          <span class="field__label">Going cold after (days)</span>
          <%= form.number_field :cold_after_days, min: 1, max: 90, placeholder: "Never", data: { action: "change->form#submit" } %>
        </label>
      <% end %>
      <%= action_button "Email me mine now", leads_digest_path, size: :sm %>
    </div>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Stages</h2>
      <p class="settings-section__description">The steps an open lead moves through, in order. New leads land in the first. Won and Lost aren’t stages: they close a lead.</p>
    </header>
    <ol class="settings-list leads-stages">
      <% @stages.each_with_index do |stage, index| %>
        <%# herb:key stage.id %>
        <li class="list-row leads-stage">
          <%= form_with model: stage, url: leads_stage_path(stage), scope: :stage, method: :patch, namespace: "stage_#{stage.id}", class: "leads-stage__name", data: { controller: "form" } do |form| %>
            <%= form.text_field :name, maxlength: 40, aria: { label: "Stage name" }, data: { action: "change->form#submit" } %>
          <% end %>
          <span class="small muted leads-stage__count"><%= pluralize(@open_counts.fetch(stage.id, 0), "open lead") %></span>
          <div class="list-row__actions">
            <% if index.positive? %>
              <%= button_to leads_stage_path(stage), method: :patch, params: { move: "up" }, class: "icon-button", title: "Move up", aria: { label: "Move #{stage.name} up" } do %><%= icon_tag "arrow-up" %><% end %>
            <% end %>
            <% if @stages.size > 1 && !@used_stage_ids.include?(stage.id) %>
              <%= render "layouts/shared/delete_dialog", name: stage.name, path: leads_stage_path(stage), message: "No lead is in it, so nothing moves." %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
    <%= form_with url: leads_stages_path, scope: :stage, class: "leads-inline-add", namespace: "new_stage" do |form| %>
      <%= form.text_field :name, required: true, maxlength: 40, placeholder: "Discovery call", autocomplete: "off", aria: { label: "New stage" } %>
      <button type="submit" class="btn btn--secondary btn--sm"><%= icon_tag "add" %> <span>Add a stage</span></button>
    <% end %>
  </section>

  <section class="settings-section" id="plans">
    <header class="settings-section__head">
      <h2>Plans</h2>
      <p class="settings-section__description">What happens when a lead arrives at each stage: its steps, each due some days later, and the email it starts from. A lead gets a stage’s steps once, however often it comes back. Changing a plan changes what leads get from now on.</p>
    </header>
    <% @stages.each do |stage| %>
      <%# herb:key stage.id %>
      <div class="leads-plan-stage">
        <h3 class="leads-plan-stage__name"><%= stage.name %></h3>
        <% steps = @plans.fetch(stage.id, []) %>
        <% if steps.any? %>
          <ul class="settings-list">
            <% steps.each do |step| %>
              <%# herb:key step.id %>
              <li class="list-row leads-plan-step">
                <%= form_with model: step, url: leads_playbook_step_path(step), scope: :playbook_step, method: :patch, namespace: "plan_#{step.id}", class: "leads-plan-step__form", data: { controller: "form" } do |form| %>
                  <%= form.text_field :title, maxlength: 200, aria: { label: "Step" }, data: { action: "change->form#submit" } %>
                  <%= form.number_field :days_after, min: 0, max: 365, class: "leads-plan-step__days", aria: { label: "Days after arriving" }, data: { action: "change->form#submit" } %>
                  <span class="small muted">days on</span>
                  <%= form.select :template_id, [ [ "No email", "" ] ] + @templates.map { [ it.name, it.id ] }, { selected: step.template_id.to_s }, aria: { label: "Email it starts from" }, data: { action: "change->form#submit" } %>
                <% end %>
                <div class="list-row__actions">
                  <%= render "layouts/shared/delete_dialog", name: step.title, path: leads_playbook_step_path(step), message: "Leads already given it keep theirs." %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="small muted">No plan: leads arriving here get no steps.</p>
        <% end %>
        <%= form_with url: leads_playbook_steps_path, scope: :playbook_step, class: "leads-inline-add", namespace: "new_plan_#{stage.id}" do |form| %>
          <%= hidden_field_tag "playbook_step[stage_id]", stage.id, id: nil %>
          <%= form.text_field :title, required: true, maxlength: 200, placeholder: "Send a case study", autocomplete: "off", aria: { label: "New step for #{stage.name}" } %>
          <%= form.number_field :days_after, value: 0, min: 0, max: 365, class: "leads-plan-step__days", aria: { label: "Days after arriving" } %>
          <span class="small muted">days on</span>
          <%= form.select :template_id, [ [ "No email", "" ] ] + @templates.map { [ it.name, it.id ] }, {}, aria: { label: "Email it starts from" } %>
          <button type="submit" class="btn btn--secondary btn--sm"><%= icon_tag "add" %> <span>Add</span></button>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="settings-section" id="templates">
    <header class="settings-section__head">
      <h2>Email templates</h2>
      <p class="settings-section__description">Emails to start from when writing to a lead: the recap, the follow-up, the last nudge. They’re edited before they go. Filled in as they’re used: <%= Leads::Template::FIELDS.map { |key, label| "{{#{key}}} (#{label})" }.join(", ") %>.</p>
    </header>
    <% if @templates.any? %>
      <ul class="settings-list">
        <% @templates.each do |template| %>
          <%# herb:key template.id %>
          <li class="list-row leads-template-row">
            <details class="leads-template-edit">
              <summary><strong><%= template.name %></strong> <span class="muted"><%= template.subject %></span></summary>
              <%= form_with model: template, url: leads_template_path(template), scope: :template, method: :patch, namespace: "template_#{template.id}", class: "leads-form" do |form| %>
                <%= form.text_field :name, required: true, maxlength: 80, aria: { label: "Name" } %>
                <%= form.text_field :subject, required: true, maxlength: 200, aria: { label: "Subject" } %>
                <%= rich_text_field form, :body %>
                <div class="button-row"><%= submit_button form, "Save", size: :sm %></div>
              <% end %>
            </details>
            <div class="list-row__actions">
              <%= render "layouts/shared/delete_dialog", name: template.name, path: leads_template_path(template), message: "Plans and steps that start from it no longer will." %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
    <details class="leads-add">
      <summary class="<%= button_classes(size: :sm) %>"><%= icon_tag "add" %> <span>Add a template</span></summary>
      <%= form_with url: leads_templates_path, scope: :template, namespace: "new_template", class: "leads-form" do |form| %>
        <%= form.text_field :name, required: true, maxlength: 80, placeholder: "Name: Case study", autocomplete: "off", aria: { label: "Name" } %>
        <%= form.text_field :subject, required: true, maxlength: 200, placeholder: "Subject", autocomplete: "off", aria: { label: "Subject" } %>
        <%= rich_text_field form, :body, placeholder: "Hi {{first_name}}, …" %>
        <div class="button-row"><%= submit_button form, "Add", size: :sm %></div>
      <% end %>
    </details>
  </section>

  <section class="settings-section" id="forms">
    <header class="settings-section__head">
      <h2>Forms that send leads in</h2>
      <p class="settings-section__description">Each form posts its fields, as JSON or a form, to its own address. Name, email, phone, company, website and message become the lead; everything else (campaign, landing page, answers) is kept with it. The same submission sent twice, or the same email again, joins the lead rather than making another. Check for bots on your website before posting.</p>
    </header>
    <% if @keys.any? %>
      <ul class="settings-list">
        <% @keys.each do |key| %>
          <%# herb:key key.id %>
          <li class="list-row leads-key">
            <div class="list-row__content">
              <p class="list-row__title"><%= key.name %></p>
              <p class="list-row__desc"><%= pluralize(key.leads_count, "lead") %><% if key.last_used_at %>, the last <%= time_ago(key.last_used_at) %><% else %>, none yet<% end %></p>
              <%= copy_field leads_capture_url(key.token) %>
            </div>
            <div class="list-row__actions">
              <%= render "layouts/shared/delete_dialog", name: key.name, path: leads_capture_key_path(key), message: "Its address stops taking leads at once. Leads it sent stay." %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">No forms yet: add one, then paste its address into your website’s form.</p>
    <% end %>
    <%= form_with url: leads_capture_keys_path, scope: :capture_key, class: "leads-inline-add", namespace: "new_key" do |form| %>
      <%= form.text_field :name, required: true, maxlength: 60, placeholder: "Website contact form", autocomplete: "off", aria: { label: "Form name" } %>
      <button type="submit" class="btn btn--secondary btn--sm"><%= icon_tag "add" %> <span>Add a form</span></button>
    <% end %>
    <details class="leads-howto">
      <summary>What to send</summary>
      <%= code_block %(curl -X POST #{leads_capture_url("YOUR-FORM-KEY-FROM-ABOVE")} \\\n  -H "Content-Type: application/json" \\\n  -d '{"name":"Sam Lee","email":"sam@example.com","company":"Example Co","message":"We need a new website","source":"Homepage","utm_campaign":"spring","external_id":"form-123"}'), language: "bash" %>
      <p class="small muted">Answers 201 with the lead’s id when it’s new, 200 when it joined one, 422 when there’s no name, email or company, and 404 once its form is deleted. external_id (any id your website gives the submission) stops a resend counting twice. A referral sends referral_company, referral_contact, referral_email, referral_phone and referral_website: the lead is the business referred, and the sender is kept as who referred them.</p>
    </details>
  </section>
</div>
